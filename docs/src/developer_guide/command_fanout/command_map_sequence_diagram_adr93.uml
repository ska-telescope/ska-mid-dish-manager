@startuml

title SetStandbyLPMode with SPF ignored

participant Client
participant DishManager
participant ActionHandler
participant DS
participant SPF
participant SPFRx

Client -> DishManager: ignoreSpf = True
Client -> DishManager: SetStandbyLPMode()

DishManager -> DishManager: is_command_allowed()

alt Command not allowed
    DishManager --> Client: Error: command not allowed
else Command allowed
    DishManager -> ActionHandler: SetStandbyLPModeAction.execute()

    group Fan out
        ActionHandler -> DS: SetStandbyMode()
        ActionHandler -x SPF: not dispatched
        note right of ActionHandler
          is_device_ignored("SPF") is True, so the
          command is counted as successful without
          being sent
        end note
        ActionHandler -> SPFRx: SetStandbyMode()
    end

    group Wait
        DS --> DishManager: operatingmode = STANDBY\npowerstate = LOW_POWER
        SPFRx --> DishManager: operatingmode = STANDBY
        DishManager -> DishManager: compute_dish_mode()
        note left of DishManager
          SPF is left out of the
          transition rule aggregation
        end note
    end

    ActionHandler --> Client: LRC completed
    Client -> DishManager: read dishMode
    DishManager --> Client: dishMode = STANDBY_LP
end

@enduml
